build/
out/
.cache/
vcpkg_installed/
compile_commands.json
tests/fixtures/pack/
.DS_Store
__pycache__/

# The frontend's dependencies and build output. package.json and the lockfile are committed;
# node_modules is not (docs/decisions/0043-a-plain-typescript-frontend.md).
web/node_modules/
web/dist/

# Playwright's own output: the report, the traces and the videos of a failing run. CI uploads them
# as an artefact instead (docs/decisions/0045-end-to-end-tests-in-a-real-browser.md).
web/playwright-report/
web/test-results/

out/runs/

# The A/B measurement's temporary configs: an example's own config with a fixed output name, so two
# binaries' results can be compared byte for byte (docs/performance.md).
examples/*/ab-config.json
examples/*/measure-config.json
